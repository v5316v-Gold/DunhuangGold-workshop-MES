<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_gold_measurement_tree" model="ir.ui.view">
            <field name="name">gold.measurement.tree</field>
            <field name="model">gold.measurement</field>
            <field name="arch" type="xml">
                <tree string="计量单位">
                    <field name="sequence" widget="handle"/>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="category"/>
                    <field name="factor_to_gram" digits="[20,10]"/>
                    <field name="precision_digits"/>
                    <field name="active" widget="boolean_toggle"/>
                </tree>
            </field>
        </record>
        <record id="view_gold_measurement_form" model="ir.ui.view">
            <field name="name">gold.measurement.form</field>
            <field name="model">gold.measurement</field>
            <field name="arch" type="xml">
                <form string="计量单位">
                    <sheet>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="name"/>
                                <field name="category"/>
                            </group>
                            <group>
                                <field name="factor_to_gram"/>
                                <field name="precision_digits"/>
                                <field name="sequence"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <field name="note" placeholder="备注"/>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_gold_measurement" model="ir.actions.act_window">
            <field name="name">计量单位</field>
            <field name="res_model">gold.measurement</field>
            <field name="view_mode">tree,form</field>
            <field name="help">敦煌金加工车间计量的核心单位字典,固定 0.001g 精度</field>
        </record>
    </data>
</odoo>
