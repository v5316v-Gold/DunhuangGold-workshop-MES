<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_gold_recycle_tree" model="ir.ui.view">
            <field name="name">gold.recycle.tree</field>
            <field name="model">gold.recycle</field>
            <field name="arch" type="xml">
                <tree string="旧金回收" decoration-danger="is_large_amount">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="id_number"/>
                    <field name="categ_id"/>
                    <field name="net_weight_g" digits="[18,6]"/>
                    <field name="final_purity" digits="[6,4]" widget="percentage"/>
                    <field name="price_at_time" digits="[18,4]"/>
                    <field name="discount_factor" digits="[6,4]"/>
                    <field name="valuation_amount" digits="[18,2]"/>
                    <field name="is_large_amount" widget="boolean_toggle"/>
                    <field name="state" widget="badge"
                        decoration-info="state == 'draft'"
                        decoration-warning="state == 'inspecting'"
                        decoration-success="state in ['confirmed', 'refining', 'done']"/>
                    <field name="batch_id"/>
                </tree>
            </field>
        </record>

        <record id="view_gold_recycle_form" model="ir.ui.view">
            <field name="name">gold.recycle.form</field>
            <field name="model">gold.recycle</field>
            <field name="arch" type="xml">
                <form string="旧金回收">
                    <header>
                        <button name="action_inspecting" string="启动化验" type="object"
                            class="btn-primary" states="draft"
                            groups="group_dunhuanggold_workshop_mes_director"/>
                        <button name="action_quoted" string="报价" type="object"
                            class="btn-primary" states="inspecting"
                            groups="group_dunhuanggold_workshop_mes_director"/>
                        <button name="action_confirmed" string="客户确认" type="object"
                            class="btn-primary" states="quoted"
                            groups="group_dunhuanggold_workshop_mes_director"/>
                        <button name="action_refining" string="提纯" type="object"
                            class="btn-primary" states="confirmed"
                            groups="group_dunhuanggold_workshop_mes_director"/>
                        <button name="action_done" string="入库" type="object"
                            class="btn-primary" states="refining"
                            groups="group_dunhuanggold_workshop_mes_director"/>
                        <button name="action_cancel" string="取消" type="object"
                            states="draft,inspecting,quoted,confirmed" groups="group_dunhuanggold_workshop_mes_director"/>
                        <field name="state" widget="statusbar"
                            statusbar_visible="draft,inspecting,quoted,confirmed,refining,done"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name" placeholder="回收单号"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="partner_id"/>
                                <field name="id_number"/>
                                <field name="id_image" widget="image"/>
                                <field name="phone"/>
                                <field name="address"/>
                            </group>
                            <group>
                                <field name="categ_id"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="inspector_id"/>
                                <field name="inspection_date"/>
                                <field name="is_large_amount" widget="boolean_toggle"/>
                                <field name="aml_report_id"
                                    invisible="not is_large_amount"/>
                            </group>
                        </group>
                        <group string="重量">
                            <group>
                                <field name="gross_weight_g" digits="[18,6]"/>
                                <field name="tare_weight_g" digits="[18,6]"/>
                                <field name="net_weight_g" digits="[18,6]"/>
                            </group>
                            <group>
                                <field name="xrf_purity" digits="[6,4]" widget="percentage"/>
                                <field name="fire_purity" digits="[6,4]" widget="percentage"/>
                                <field name="final_purity" digits="[6,4]" widget="percentage"/>
                            </group>
                        </group>
                        <group string="估价">
                            <group>
                                <field name="price_at_time" digits="[18,4]"/>
                                <field name="discount_factor" digits="[6,4]"/>
                            </group>
                            <group>
                                <field name="valuation_amount" digits="[18,2]"
                                    class="oe_subtotal_footer_separator"/>
                            </group>
                        </group>
                        <group string="后续">
                            <field name="batch_id" readonly="1"/>
                            <field name="invoice_id"/>
                        </group>
                        <field name="note" placeholder="备注"/>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="action_gold_recycle" model="ir.actions.act_window">
            <field name="name">旧金回收</field>
            <field name="res_model">gold.recycle</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
