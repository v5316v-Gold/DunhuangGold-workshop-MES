<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- 工艺工序: 列表 -->
        <record id="view_gold_process_operation_tree" model="ir.ui.view">
            <field name="name">gold.process.operation.tree</field>
            <field name="model">gold.process.operation</field>
            <field name="arch" type="xml">
                <tree string="工艺工序">
                    <field name="sequence" widget="handle"/>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="process_type"/>
                    <field name="equipment_category"/>
                    <field name="standard_time_hours" digits="[10,4]"/>
                    <field name="standard_loss_rate" digits="[6,4]"/>
                    <field name="need_quality_check" widget="boolean_toggle"/>
                    <field name="collect_weight" widget="boolean_toggle"/>
                    <field name="returnable_gold" widget="boolean_toggle"/>
                    <field name="returnable_wax" widget="boolean_toggle"/>
                    <field name="active" widget="boolean_toggle"/>
                </tree>
            </field>
        </record>

        <!-- 工艺工序: 看板 -->
        <record id="view_gold_process_operation_kanban" model="ir.ui.view">
            <field name="name">gold.process.operation.kanban</field>
            <field name="model">gold.process.operation</field>
            <field name="arch" type="xml">
                <kanban default_group_by="process_type">
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="oe_kanban_details">
                                    <strong>[<field name="code"/>] <field name="name"/></strong>
                                    <div class="text-muted">
                                        工时: <field name="standard_time_hours" digits="[10,4]"/> h
                                        / 损耗: <field name="standard_loss_rate" digits="[6,4]"/> %
                                    </div>
                                    <div class="text-muted">
                                        设备: <field name="equipment_category"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- 工艺工序: 表单 -->
        <record id="view_gold_process_operation_form" model="ir.ui.view">
            <field name="name">gold.process.operation.form</field>
            <field name="model">gold.process.operation</field>
            <field name="arch" type="xml">
                <form string="工艺工序">
                    <sheet>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="name"/>
                                <field name="process_type"/>
                                <field name="sequence"/>
                            </group>
                            <group>
                                <field name="equipment_category"/>
                                <field name="workstation_id"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <group string="工艺定额">
                            <group>
                                <field name="standard_time_hours" digits="[10,4]"/>
                                <field name="standard_loss_rate" digits="[6,4]"/>
                            </group>
                            <group>
                                <field name="need_quality_check" widget="boolean_toggle"/>
                                <field name="collect_weight" widget="boolean_toggle"/>
                                <field name="collect_dimension" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <group string="业务属性">
                            <group>
                                <field name="can_outsource" widget="boolean_toggle"/>
                                <field name="returnable_wax" widget="boolean_toggle"/>
                                <field name="returnable_gold" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <field name="note" placeholder="备注"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_gold_process_operation" model="ir.actions.act_window">
            <field name="name">工艺工序</field>
            <field name="res_model">gold.process.operation</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="help">敦煌金加工车间工艺工序字典,油压 9 道 + 失蜡 11 道</field>
        </record>
    </data>
</odoo>
