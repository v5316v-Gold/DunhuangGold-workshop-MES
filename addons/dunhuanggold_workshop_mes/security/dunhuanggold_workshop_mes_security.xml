<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================
             车间 ERP 角色定义
             ============================================================ -->

        <record id="module_category_dunhuanggold_workshop_mes" model="ir.module.category">
            <field name="name">敦煌金加工车间 ERP</field>
            <field name="description">贵金属首饰加工车间专用 ERP 角色</field>
            <field name="sequence">90</field>
        </record>

        <record id="group_dunhuanggold_workshop_mes_user" model="res.groups">
            <field name="name">车间操作员</field>
            <field name="category_id" ref="module_category_dunhuanggold_workshop_mes"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_dunhuanggold_workshop_mes_leader" model="res.groups">
            <field name="name">车间班组长</field>
            <field name="category_id" ref="module_category_dunhuanggold_workshop_mes"/>
            <field name="implied_ids" eval="[(4, ref('group_dunhuanggold_workshop_mes_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_dunhuanggold_workshop_mes_director" model="res.groups">
            <field name="name">车间主任</field>
            <field name="category_id" ref="module_category_dunhuanggold_workshop_mes"/>
            <field name="implied_ids" eval="[(4, ref('group_dunhuanggold_workshop_mes_leader'))]"/>
        </record>

        <record id="group_dunhuanggold_workshop_mes_qc" model="res.groups">
            <field name="name">质检员</field>
            <field name="category_id" ref="module_category_dunhuanggold_workshop_mes"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_dunhuanggold_workshop_mes_warehouse" model="res.groups">
            <field name="name">金库仓管员</field>
            <field name="category_id" ref="module_category_dunhuanggold_workshop_mes"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_dunhuanggold_workshop_mes_device" model="res.groups">
            <field name="name">设备维护员</field>
            <field name="category_id" ref="module_category_dunhuanggold_workshop_mes"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_dunhuanggold_workshop_mes_ehs" model="res.groups">
            <field name="name">环境安全员 (EHS)</field>
            <field name="category_id" ref="module_category_dunhuanggold_workshop_mes"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- 多公司隔离 -->
        <record id="rule_dunhuanggold_workshop_mes_company" model="ir.rule">
            <field name="name">车间 ERP 数据按公司隔离</field>
            <field name="model_id" ref="model_gold_material_batch"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_dunhuanggold_workshop_mes_user'))]"/>
        </record>

        <record id="rule_dunhuanggold_workshop_mes_company_production" model="ir.rule">
            <field name="name">生产订单按公司隔离</field>
            <field name="model_id" ref="model_mrp_production"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_dunhuanggold_workshop_mes_user'))]"/>
        </record>

    </data>
</odoo>
