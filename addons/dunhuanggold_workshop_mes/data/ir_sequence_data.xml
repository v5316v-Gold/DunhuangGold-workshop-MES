<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 金料批次号: GLYYYYMMDDXXX -->
        <record id="seq_gold_batch" model="ir.sequence">
            <field name="name">金料批次号</field>
            <field name="code">gold.material.batch</field>
            <field name="prefix">GL</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- 金料入库单: RKYYYYMMXXX -->
        <record id="seq_gold_in" model="ir.sequence">
            <field name="name">金料入库单</field>
            <field name="code">gold.material.in</field>
            <field name="prefix">RK</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- 旧金回收单: HSYYYYMMXXX -->
        <record id="seq_gold_recycle" model="ir.sequence">
