<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 重量单位 -->
        <record id="measurement_g" model="gold.measurement">
            <field name="code">g</field>
            <field name="name">克 (g)</field>
            <field name="category">weight</field>
            <field name="factor_to_gram">1.0000000000</field>
            <field name="precision_digits">3</field>
            <field name="sequence">10</field>
        </record>
        <record id="measurement_mg" model="gold.measurement">
            <field name="code">mg</field>
            <field name="name">毫克 (mg)</field>
            <field name="category">weight</field>
            <field name="factor_to_gram">0.0010000000</field>
            <field name="precision_digits">0</field>
            <field name="sequence">20</field>
        </record>
        <record id="measurement_kg" model="gold.measurement">
            <field name="code">kg</field>
            <field name="name">千克 (kg)</field>
            <field name="category">weight</field>
            <field name="factor_to_gram">1000.0000000000</field>
            <field name="precision_digits">6</field>
            <field name="sequence">30</field>
        </record>
        <record id="measurement_oz" model="gold.measurement">
            <field name="code">oz</field>
            <field name="name">金衡盎司 (oz t)</field>
            <field name="category">weight</field>
            <field name="factor_to_gram">31.1034768000</field>
            <field name="precision_digits">4</field>
            <field name="sequence">40</field>
        </record>
        <record id="measurement_qian" model="gold.measurement">
            <field name="code">qian</field>
            <field name="name">钱 (港台, 1钱=3.75g)</field>
            <field name="category">weight</field>
            <field name="factor_to_gram">3.7500000000</field>
            <field name="precision_digits">3</field>
            <field name="sequence">50</field>
        </record>
        <record id="measurement_liang" model="gold.measurement">
            <field name="code">liang</field>
            <field name="name">两 (港台, 1两=37.5g)</field>
            <field name="category">weight</field>
            <field name="factor_to_gram">37.5000000000</field>
            <field name="precision_digits">3</field>
            <field name="sequence">60</field>
        </record>
        <record id="measurement_ct" model="gold.measurement">
            <field name="code">ct</field>
            <field name="name">克拉 (ct, 宝石, 1ct=0.2g)</field>
            <field name="category">weight</field>
            <field name="factor_to_gram">0.2000000000</field>
            <field name="precision_digits">2</field>
            <field name="sequence">70</field>
        </record>

        <!-- 时间单位 -->
        <record id="measurement_minute" model="gold.measurement">
            <field name="code">min</field>
            <field name="name">分钟</field>
            <field name="category">time</field>
            <field name="factor_to_gram">1.0000000000</field>
            <field name="precision_digits">0</field>
            <field name="sequence">200</field>
        </record>
        <record id="measurement_hour" model="gold.measurement">
            <field name="code">h</field>
            <field name="name">小时</field>
            <field name="category">time</field>
            <field name="factor_to_gram">1.0000000000</field>
            <field name="precision_digits">2</field>
            <field name="sequence">210</field>
        </record>

        <!-- 比率 -->
        <record id="measurement_pct" model="gold.measurement">
            <field name="code">%</field>
            <field name="name">百分比 (%)</field>
            <field name="category">ratio</field>
            <field name="factor_to_gram">1.0000000000</field>
            <field name="precision_digits">2</field>
            <field name="sequence">300</field>
        </record>

        <!-- 件数 -->
        <record id="measurement_pcs" model="gold.measurement">
            <field name="code">pcs</field>
            <field name="name">件 (pcs)</field>
            <field name="category">piece</field>
            <field name="factor_to_gram">1.0000000000</field>
            <field name="precision_digits">0</field>
            <field name="sequence">400</field>
        </record>
    </data>
</odoo>
