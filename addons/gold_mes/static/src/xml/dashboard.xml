<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <!-- 看板主面板 -->
    <t t-name="gold_dashboard.Main">
        <div class="gold_dashboard">
            <div class="row header">
                <div class="col-12">
                    <h1 style="color:#B8860B; text-align:center; font-weight:bold;">
                        🏭 贵金属车间看板
                    </h1>
                    <p style="text-align:center; color:#666;">
                        油压 + 失蜡铸造 | 实时监控
                        <span t-att-class="'badge badge-' + (data.online ? 'success' : 'danger')">
                            <t t-esc="data.online ? '在线' : '离线'"/>
                        </span>
                    </p>
                </div>
            </div>

            <div class="row kpi-row">
                <!-- 当日完工 -->
                <div class="col-md-3 kpi-card">
                    <div class="card kpi-card-inner shadow">
                        <div class="card-body">
                            <h5 class="kpi-title">当日完工</h5>
                            <h2 class="kpi-value" style="color:#2E8B57;">
                                <t t-esc="data.kpi.done_today"/>
                            </h2>
                            <p class="kpi-subtitle">订单数</p>
                        </div>
                    </div>
                </div>
                <!-- 进行中 -->
                <div class="col-md-3 kpi-card">
                    <div class="card kpi-card-inner shadow">
                        <div class="card-body">
                            <h5 class="kpi-title">进行中</h5>
                            <h2 class="kpi-value" style="color:#1E90FF;">
                                <t t-esc="data.kpi.in_progress"/>
                            </h2>
                            <p class="kpi-subtitle">生产线</p>
                        </div>
                    </div>
                </div>
                <!-- 异常 -->
                <div class="col-md-3 kpi-card">
                    <div class="card kpi-card-inner shadow">
                        <div class="card-body">
                            <h5 class="kpi-title">超耗预警</h5>
                            <h2 class="kpi-value" style="color:#DC143C;">
                                <t t-esc="data.kpi.over_loss_count"/>
                            </h2>
                            <p class="kpi-subtitle">当日</p>
                        </div>
                    </div>
                </div>
                <!-- 模具预警 -->
                <div class="col-md-3 kpi-card">
                    <div class="card kpi-card-inner shadow">
                        <div class="card-body">
                            <h5 class="kpi-title">模具预警</h5>
                            <h2 class="kpi-value" style="color:#FF8C00;">
                                <t t-esc="data.kpi.critical_mold_count"/>
                            </h2>
                            <p class="kpi-subtitle">需关注</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mt-4">
                <!-- 工艺分布 -->
                <div class="col-md-6">
                    <div class="card shadow">
                        <div class="card-header">
                            <h5>工艺分布</h5>
                        </div>
                        <div class="card-body">
                            <div class="process-bar">
                                <div class="process-bar-item oil_press"
                                    t-attf-style="width: #{data.kpi.oil_press_orders * 100 / (data.kpi.oil_press_orders + data.kpi.lost_wax_orders + 1)}%">
                                    <span>油压 <t t-esc="data.kpi.oil_press_orders"/></span>
                                </div>
                                <div class="process-bar-item lost_wax"
                                    t-attf-style="width: #{data.kpi.lost_wax_orders * 100 / (data.kpi.oil_press_orders + data.kpi.lost_wax_orders + 1)}%">
                                    <span>失蜡 <t t-esc="data.kpi.lost_wax_orders"/></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 当前金价 -->
                <div class="col-md-6">
                    <div class="card shadow">
                        <div class="card-header">
                            <h5>实时金价</h5>
                        </div>
                        <div class="card-body">
                            <h2 style="color:#B8860B; font-weight:bold;">
                                ¥ <t t-esc="data.kpi.current_gold_price.toFixed(2)"/> / g
                            </h2>
                            <p class="text-muted">SGE Au99.99 收盘</p>
                            <hr/>
                            <p>库存总估值: ¥ <t t-esc="Math.round(data.kpi.total_value).toLocaleString()"/></p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mt-4">
                <!-- 损耗趋势 -->
                <div class="col-md-12">
                    <div class="card shadow">
                        <div class="card-header">
                            <h5>7 天损耗趋势</h5>
                        </div>
                        <div class="card-body">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>日期</th>
                                        <th>报工次数</th>
                                        <th>平均损耗率</th>
                                        <th>超耗次数</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="data.loss_trend" t-as="row">
                                        <td><t t-esc="row.date"/></td>
                                        <td><t t-esc="row.report_count"/></td>
                                        <td><t t-esc="row.avg_loss_rate.toFixed(2)"/>%</td>
                                        <td t-attf-class="#{row.over_loss_count > 0 ? 'text-danger' : ''}">
                                            <t t-esc="row.over_loss_count"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
