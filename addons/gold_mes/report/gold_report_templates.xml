<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ============== 质量检验报告 ============== -->
        <record id="action_report_gold_quality" model="ir.actions.report">
            <field name="name">质量检验报告</field>
            <field name="model">gold.quality.inspection</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">gold_mes.quality_report_template</field>
            <field name="report_file">gold_mes.quality_report_template</field>
            <field name="print_report_name">'Quality_%s' % (object.name)</field>
            <field name="binding_model_id" ref="model_gold_quality_inspection"/>
            <field name="binding_type">report</field>
        </record>

        <template id="quality_report_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.internal_layout">
                        <div class="page">
                            <h2 style="text-align:center; color:#B8860B;">
                                贵金属首饰质量检验报告
                            </h2>
                            <p style="text-align:center;">
                                Quality Inspection Report
                            </p>
                            <hr/>
                            <table class="table table-condensed">
                                <tr>
                                    <th>报告编号</th>
                                    <td><t t-esc="doc.name"/></td>
                                    <th>检验类型</th>
                                    <td><t t-esc="dict(
                                        {'incoming': '来料', 'in_process': '过程', 'final': '成品'}
                                    ).get(doc.inspection_type)"/></td>
                                </tr>
                                <tr>
                                    <th>生产订单</th>
                                    <td><t t-esc="doc.production_id.name or '-'"/></td>
                                    <th>金料批次</th>
                                    <td><t t-esc="doc.batch_id.batch_no or '-'"/></td>
                                </tr>
                                <tr>
                                    <th>检验员</th>
                                    <td><t t-esc="doc.inspector_id.name"/></td>
                                    <th>检验时间</th>
                                    <td><t t-esc="doc.inspection_date" t-options="{'widget': 'datetime'}"/></td>
                                </tr>
                            </table>

                            <h4>检验项目</h4>
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>项目</th>
                                        <th>实测值</th>
                                        <th>标准下限</th>
                                        <th>公差</th>
                                        <th>判定</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>重量 (g)</td>
                                        <td><t t-esc="doc.weight_g" t-options="{'precision': 6}"/></td>
                                        <td>/</td>
                                        <td>±<t t-esc="doc.weight_tolerance_g" t-options="{'precision': 6}"/></td>
                                        <td>
                                            <span t-att-class="doc.weight_passed ? 'badge badge-success' : 'badge badge-danger'">
                                                <t t-esc="doc.weight_passed and '合格' or '不合格'"/>
                                            </span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>含量 (%)</td>
                                        <td><t t-esc="doc.purity_pct" t-options="{'precision': 4}"/></td>
                                        <td>≥<t t-esc="doc.purity_min_pct" t-options="{'precision': 4}"/></td>
                                        <td>/</td>
                                        <td>
                                            <span t-att-class="doc.purity_passed ? 'badge badge-success' : 'badge badge-danger'">
                                                <t t-esc="doc.purity_passed and '合格' or '不合格'"/>
                                            </span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>印记</td>
                                        <td><t t-esc="doc.imprint_present and '有' or '无'"/></td>
                                        <td>必须</td>
                                        <td>/</td>
                                        <td>
                                            <span t-att-class="doc.imprint_passed ? 'badge badge-success' : 'badge badge-danger'">
                                                <t t-esc="doc.imprint_passed and '合格' or '不合格'"/>
                                            </span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>表面质量</td>
                                        <td>
                                            <t t-esc="dict(
                                                {'good': '良', 'minor': '轻微', 'major': '严重'}
                                            ).get(doc.surface_quality)"/>
                                        </td>
                                        <td>良</td>
                                        <td>/</td>
                                        <td>
                                            <span t-att-class="doc.surface_passed ? 'badge badge-success' : 'badge badge-danger'">
                                                <t t-esc="doc.surface_passed and '合格' or '不合格'"/>
                                            </span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <h4>综合判定</h4>
                            <p style="font-size: 24px; font-weight: bold;
                                      text-align:center;
                                      color: #B8860B;">
                                <t t-esc="dict(
                                    {'pending': '待检', 'passed': '合格', 'failed': '不合格', 'conditional': '让步接收'}
                                ).get(doc.result)"/>
                            </p>

                            <p>备注:<t t-esc="doc.note or '无'"/></p>

                            <hr/>
                            <p style="text-align:right;">
                                出具: <t t-esc="company.name"/>
                            </p>
                            <p style="text-align:right;">
                                出具日期: <t t-esc="doc.inspection_date" t-options="{'widget': 'date'}"/>
                            </p>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <!-- ============== XRF 含量检测报告 ============== -->
        <record id="action_report_gold_xrf" model="ir.actions.report">
            <field name="name">XRF 含量检测报告</field>
            <field name="model">gold.xrf.record</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">gold_mes.xrf_report_template</field>
            <field name="report_file">gold_mes.xrf_report_template</field>
            <field name="print_report_name">'XRF_%s' % (object.name)</field>
            <field name="binding_model_id" ref="model_gold_xrf_record"/>
            <field name="binding_type">report</field>
        </record>

        <template id="xrf_report_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.internal_layout">
                        <div class="page">
                            <h2 style="text-align:center; color:#B8860B;">
                                XRF 贵金属含量检测报告
                            </h2>
                            <p style="text-align:center;">
                                XRF Detection Report (GB/T 18043-2013)
                            </p>
                            <hr/>
                            <table class="table table-condensed">
                                <tr>
                                    <th>检测编号</th>
                                    <td><t t-esc="doc.name"/></td>
                                    <th>检测时间</th>
                                    <td><t t-esc="doc.detection_time" t-options="{'widget': 'datetime'}"/></td>
                                </tr>
                                <tr>
                                    <th>生产订单</th>
                                    <td><t t-esc="doc.production_id.name or '-'"/></td>
                                    <th>物料</th>
                                    <td><t t-esc="doc.product_id.display_name or '-'"/></td>
                                </tr>
                                <tr>
                                    <th>检测员</th>
                                    <td><t t-esc="doc.operator_id.name"/></td>
                                    <th>复核员</th>
                                    <td><t t-esc="doc.approver_id.name or '-'"/></td>
                                </tr>
                                <tr>
                                    <th>设备</th>
                                    <td><t t-esc="doc.equipment_id.display_name or '-'"/></td>
                                    <th>方法</th>
                                    <td><t t-esc="dict(
                                        {'standard': '标准法', 'quant': '定量法', 'qualitative': '定性'}
                                    ).get(doc.method)"/></td>
                                </tr>
                            </table>

                            <h4>金属含量 (mass %)</h4>
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>金属</th>
                                        <th>含量 (%)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr><td>Au (金)</td><td><t t-esc="doc.gold_pct" t-options="{'precision': 4}"/></td></tr>
                                    <tr><td>Pt (铂)</td><td><t t-esc="doc.platinum_pct" t-options="{'precision': 4}"/></td></tr>
                                    <tr><td>Pd (钯)</td><td><t t-esc="doc.palladium_pct" t-options="{'precision': 4}"/></td></tr>
                                    <tr><td>Ag (银)</td><td><t t-esc="doc.silver_pct" t-options="{'precision': 4}"/></td></tr>
                                    <tr><td>Cu (铜)</td><td><t t-esc="doc.copper_pct" t-options="{'precision': 4}"/></td></tr>
                                    <tr><td>Zn (锌)</td><td><t t-esc="doc.zinc_pct" t-options="{'precision': 4}"/></td></tr>
                                    <tr><td>Ni (镍)</td><td><t t-esc="doc.nickel_pct" t-options="{'precision': 4}"/></td></tr>
                                </tbody>
                            </table>

                            <h4>判定结果</h4>
                            <table class="table">
                                <tr>
                                    <th>主金属含量</th>
                                    <td><t t-esc="doc.main_metal_pct" t-options="{'precision': 4}"/> %</td>
                                </tr>
                                <tr>
                                    <th>标准下限</th>
                                    <td>≥<t t-esc="doc.standard_pct" t-options="{'precision': 4}"/> %</td>
                                </tr>
                                <tr>
                                    <th>判定</th>
                                    <td>
                                        <strong style="font-size: 18px;">
                                            <span t-att-class="doc.is_passed ? 'badge badge-success' : 'badge badge-danger'">
                                                <t t-esc="doc.is_passed and '合格' or '不合格'"/>
                                            </span>
                                        </strong>
                                    </td>
                                </tr>
                            </table>

                            <p style="text-align:right;">
                                出具: <t t-esc="company.name"/>
                            </p>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <!-- ============== 金料批次详情 ============== -->
        <record id="action_report_gold_batch" model="ir.actions.report">
            <field name="name">金料批次详情</field>
            <field name="model">gold.material.batch</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">gold_mes.batch_report_template</field>
            <field name="report_file">gold_mes.batch_report_template</field>
            <field name="print_report_name">'Batch_%s' % (object.batch_no)</field>
            <field name="binding_model_id" ref="model_gold_material_batch"/>
            <field name="binding_type">report</field>
        </record>

        <template id="batch_report_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.internal_layout">
                        <div class="page">
                            <h2 style="text-align:center; color:#B8860B;">
                                金料批次详情
                            </h2>
                            <hr/>
                            <table class="table">
                                <tr><th>批次号</th><td><t t-esc="doc.batch_no"/></td></tr>
                                <tr><th>物料</th><td><t t-esc="doc.product_id.display_name"/></td></tr>
                                <tr><th>成色</th><td><t t-esc="doc.gold_purity" t-options="{'precision': 2}"/> %</td></tr>
                                <tr><th>毛重</th><td><t t-esc="doc.gross_weight_g" t-options="{'precision': 6}"/> g</td></tr>
                                <tr><th>净重</th><td><t t-esc="doc.net_weight_g" t-options="{'precision': 6}"/> g</td></tr>
                                <tr><th>可用</th><td><t t-esc="doc.available_weight_g" t-options="{'precision': 6}"/> g</td></tr>
                                <tr><th>已分配</th><td><t t-esc="doc.allocated_weight_g" t-options="{'precision': 6}"/> g</td></tr>
                                <tr><th>已消耗</th><td><t t-esc="doc.consumed_weight_g" t-options="{'precision': 6}"/> g</td></tr>
                                <tr><th>入库单价</th><td>¥ <t t-esc="doc.unit_price" t-options="{'precision': 4}"/> /g</td></tr>
                                <tr><th>入库总价</th><td>¥ <t t-esc="doc.total_value" t-options="{'precision': 2}"/></td></tr>
                                <tr><th>当前金价</th><td>¥ <t t-esc="doc.current_price" t-options="{'precision': 4}"/> /g</td></tr>
                                <tr><th>当前价值</th><td>¥ <t t-esc="doc.current_value" t-options="{'precision': 2}"/></td></tr>
                                <tr><th>来源</th>
                                    <td><t t-esc="doc.source"/> / <t t-esc="doc.is_recycle and '回收料' or '原生'"/></td>
                                </tr>
                                <tr><th>供应商</th><td><t t-esc="doc.supplier_id.name or '-'"/></td></tr>
                                <tr><th>证书号</th><td><t t-esc="doc.cert_no or '-'"/></td></tr>
                                <tr><th>入库日期</th><td><t t-esc="doc.receive_date" t-options="{'widget': 'date'}"/></td></tr>
                                <tr><th>状态</th>
                                    <td><t t-esc="dict(
                                        {'draft': '草稿', 'available': '可用', 'locked': '锁定', 'consumed': '已消耗', 'depleted': '已耗尽', 'scrap': '报废'}
                                    ).get(doc.state)"/></td>
                                </tr>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <!-- ============== 工序报工汇总 ============== -->
        <record id="action_report_gold_workorder_summary" model="ir.actions.report">
            <field name="name">工序报工汇总</field>
            <field name="model">mrp.production</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">gold_mes.workorder_summary_template</field>
            <field name="report_file">gold_mes.workorder_summary_template</field>
            <field name="print_report_name">'WO_%s' % (object.name)</field>
            <field name="binding_model_id" ref="mrp.model_mrp_production"/>
            <field name="binding_type">report</field>
        </record>

        <template id="workorder_summary_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.internal_layout">
                        <div class="page">
                            <h2 style="text-align:center; color:#B8860B;">
                                工序报工汇总
                            </h2>
                            <hr/>
                            <table class="table table-condensed">
                                <tr>
                                    <th>生产订单</th>
                                    <td><t t-esc="doc.name"/></td>
                                    <th>工艺</th>
                                    <td><t t-esc="dict(
                                        {'oil_press': '油压', 'lost_wax': '失蜡'}
                                    ).get(doc.gold_process_type)"/></td>
                                </tr>
                                <tr>
                                    <th>产品</th>
                                    <td><t t-esc="doc.product_id.display_name"/></td>
                                    <th>数量</th>
                                    <td><t t-esc="doc.product_qty"/></td>
                                </tr>
                                <tr>
                                    <th>计划金料</th>
                                    <td><t t-esc="doc.gold_planned_weight_g" t-options="{'precision': 6}"/> g</td>
                                    <th>实际金料</th>
                                    <td><t t-esc="doc.gold_actual_weight_g" t-options="{'precision': 6}"/> g</td>
                                </tr>
                                <tr>
                                    <th>实际铸件</th>
                                    <td><t t-esc="doc.gold_actual_cast_weight_g" t-options="{'precision': 6}"/> g</td>
                                    <th>实际损耗率</th>
                                    <td><t t-esc="doc.gold_actual_loss_rate" t-options="{'precision': 4}"/> %</td>
                                </tr>
                            </table>

                            <h4>工序报工明细</h4>
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>工序</th>
                                        <th>投料 (g)</th>
                                        <th>产出 (g)</th>
                                        <th>损耗 (g)</th>
                                        <th>损耗率 (%)</th>
                                        <th>工时 (h)</th>
                                        <th>质量</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="report_lines" t-as="r">
                                        <td><t t-esc="r.operation_id.name"/></td>
                                        <td><t t-esc="r.input_weight_g" t-options="{'precision': 6}"/></td>
                                        <td><t t-esc="r.output_weight_g" t-options="{'precision': 6}"/></td>
                                        <td><t t-esc="r.loss_g" t-options="{'precision': 6}"/></td>
                                        <td><t t-esc="r.loss_rate" t-options="{'precision': 4}"/></td>
                                        <td><t t-esc="r.work_hours" t-options="{'precision': 4}"/></td>
                                        <td><t t-esc="r.quality_state"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <!-- ============== 委外加工 ============== -->
        <record id="action_report_gold_outsource" model="ir.actions.report">
            <field name="name">委外加工单</field>
            <field name="model">gold.outsource.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">gold_mes.outsource_report_template</field>
            <field name="report_file">gold_mes.outsource_report_template</field>
            <field name="print_report_name">'Outsource_%s' % (object.name)</field>
            <field name="binding_model_id" ref="model_gold_outsource_order"/>
            <field name="binding_type">report</field>
        </record>

        <template id="outsource_report_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.internal_layout">
                        <div class="page">
                            <h2 style="text-align:center; color:#B8860B;">
                                委外加工单
                            </h2>
                            <hr/>
                            <table class="table">
                                <tr><th>委外单号</th><td><t t-esc="doc.name"/></td></tr>
                                <tr><th>外协厂</th><td><t t-esc="doc.partner_id.name"/></td></tr>
                                <tr><th>加工工艺</th>
                                    <td><t t-esc="dict(
                                        {'lost_wax': '失蜡', 'stone_setting': '镶石', 'plating': '电镀', 'polishing': '抛光', 'laser_weld': '激光焊接', 'other': '其他'}
                                    ).get(doc.process_type)"/></td>
                                </tr>
                                <tr><th>业务类型</th>
                                    <td><t t-esc="dict(
                                        {'include_material': '包工包料', 'exclude_material': '包工不包料'}
                                    ).get(doc.outsource_type)"/></td>
                                </tr>
                                <tr><th>发料批次</th><td><t t-esc="doc.outgoing_batch_id.batch_no"/></td></tr>
                                <tr><th>发料重量</th><td><t t-esc="doc.outgoing_weight_g" t-options="{'precision': 6}"/> g</td></tr>
                                <tr><th>收回重量</th><td><t t-esc="doc.incoming_weight_g" t-options="{'precision': 6}"/> g</td></tr>
                                <tr><th>收回件数</th><td><t t-esc="doc.incoming_piece_count"/></td></tr>
                                <tr><th>损耗</th><td><t t-esc="doc.loss_g" t-options="{'precision': 6}"/> g (<t t-esc="doc.loss_rate" t-options="{'precision': 4}"/> %)</td></tr>
                                <tr><th>损耗承担</th>
                                    <td><t t-esc="dict(
                                        {'self': '我方', 'supplier': '外协厂'}
                                    ).get(doc.loss_charge_party)"/></td>
                                </tr>
                                <tr><th>加工费</th><td>¥ <t t-esc="doc.processing_fee" t-options="{'precision': 2}"/></td></tr>
                                <tr><th>金料损耗佣</th><td>¥ <t t-esc="doc.gold_loss_charge" t-options="{'precision': 2}"/></td></tr>
                                <tr><th>应付总额</th><td><strong style="color:#B8860B;">¥ <t t-esc="doc.total_amount" t-options="{'precision': 2}"/></strong></td></tr>
                                <tr><th>发料日期</th><td><t t-esc="doc.issue_date" t-options="{'widget': 'date'}"/></td></tr>
                                <tr><th>实际收回</th><td><t t-esc="doc.actual_return_date" t-options="{'widget': 'date'}" t-out="'doc.actual_return_date or \'-\''"/></td></tr>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <!-- ============== 损耗追溯报告 ============== -->
        <record id="action_report_gold_loss_trace" model="ir.actions.report">
            <field name="name">损耗追溯报告</field>
            <field name="model">gold.loss.trace</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">gold_mes.loss_trace_report_template</field>
            <field name="report_file">gold_mes.loss_trace_report_template</field>
            <field name="print_report_name">'LossTrace_%s' % (object.name)</field>
            <field name="binding_model_id" ref="model_gold_loss_trace"/>
            <field name="binding_type">report</field>
        </record>

        <template id="loss_trace_report_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.internal_layout">
                        <div class="page">
                            <h2 style="text-align:center; color:#B8860B;">
                                损耗追溯报告
                            </h2>
                            <hr/>
                            <table class="table">
                                <tr><th>追溯单号</th><td><t t-esc="doc.name"/></td></tr>
                                <tr><th>生产订单</th><td><t t-esc="doc.production_id.name"/></td></tr>
                                <tr><th>工序</th><td><t t-esc="doc.operation_id.name"/></td></tr>
                                <tr><th>投料</th><td><t t-esc="doc.input_weight_g" t-options="{'precision': 6}"/> g</td></tr>
                                <tr><th>产出</th><td><t t-esc="doc.output_weight_g" t-options="{'precision': 6}"/> g</td></tr>
                                <tr><th>损耗</th><td><t t-esc="doc.loss_g" t-options="{'precision': 6}"/> g</td></tr>
                                <tr><th>损耗率</th><td><t t-esc="doc.loss_rate" t-options="{'precision': 4}"/> %</td></tr>
                                <tr><th>定额损耗率</th><td><t t-esc="doc.standard_loss_rate" t-options="{'precision': 4}"/> %</td></tr>
                                <tr><th>差异</th>
                                    <td>
                                        <strong t-att-class="doc.is_over_loss and 'text-danger' or ''">
                                            <t t-esc="doc.loss_diff_pct" t-options="{'precision': 4}"/> %
                                            <t t-if="doc.is_over_loss">[超耗]</t>
                                        </strong>
                                    </td>
                                </tr>
                                <tr><th>复盘状态</th>
                                    <td><t t-esc="dict(
                                        {'pending': '待复盘', 'in_progress': '复盘中', 'resolved': '已处理', 'ignored': '已忽略'}
                                    ).get(doc.review_status)"/></td>
                                </tr>
                                <tr><th>复盘结论</th>
                                    <td><t t-esc="doc.review_note or '未复盘'"/></td>
                                </tr>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
