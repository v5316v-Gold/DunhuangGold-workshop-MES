<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ======================= 员工资质证书 ======================= -->
        <record id="view_gold_employee_certificate_tree" model="ir.ui.view">
            <field name="name">gold.employee.certificate.tree</field>
            <field name="model">gold.employee.certificate</field>
            <field name="arch" type="xml">
                <tree string="员工资质证书" decoration-danger="not is_valid">
                    <field name="name"/>
                    <field name="cert_no"/>
                    <field name="cert_type"/>
                    <field name="cert_level"/>
                    <field name="holder_id"/>
                    <field name="issue_date"/>
                    <field name="expiry_date"/>
                    <field name="is_valid" widget="boolean_toggle"/>
                    <field name="days_to_expire"/>
                </tree>
            </field>
        </record>

        <record id="view_gold_employee_certificate_form" model="ir.ui.view">
            <field name="name">gold.employee.certificate.form</field>
            <field name="model">gold.employee.certificate</field>
            <field name="arch" type="xml">
                <form string="资质证书">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name" placeholder="证书名称"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="cert_type"/>
                                <field name="cert_level"/>
                                <field name="cert_no"/>
                            </group>
                            <group>
                                <field name="holder_id"/>
                                <field name="issuing_authority"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="issue_date"/>
                                <field name="expiry_date"/>
                            </group>
                            <group>
                                <field name="is_valid" widget="boolean_toggle"/>
                                <field name="days_to_expire"/>
                            </group>
                        </group>
                        <group string="证书扫描件">
                            <group>
                                <field name="cert_attachment" filename="cert_filename"/>
                                <field name="cert_filename" invisible="1"/>
                            </group>
                        </group>
                        <field name="note" placeholder="备注"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_gold_employee_certificate" model="ir.actions.act_window">
            <field name="name">员工资质证书</field>
            <field name="res_model">gold.employee.certificate</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- ======================= 考勤 / 工时 ======================= -->
        <record id="view_gold_work_attendance_tree" model="ir.ui.view">
            <field name="name">gold.work.attendance.tree</field>
            <field name="model">gold.work.attendance</field>
            <field name="arch" type="xml">
                <tree string="考勤 / 工时">
                    <field name="shift_date"/>
                    <field name="employee_id"/>
                    <field name="shift_type"/>
                    <field name="workstation_id"/>
                    <field name="check_in"/>
                    <field name="check_out"/>
                    <field name="work_hours"/>
                    <field name="report_count"/>
                    <field name="attendance_state" widget="badge"
                        decoration-success="attendance_state == 'normal'"
                        decoration-warning="attendance_state in ('late', 'early_leave')"
                        decoration-danger="attendance_state == 'absent'"/>
                </tree>
            </field>
        </record>

        <record id="view_gold_work_attendance_form" model="ir.ui.view">
            <field name="name">gold.work.attendance.form</field>
            <field name="model">gold.work.attendance</field>
            <field name="arch" type="xml">
                <form string="考勤记录">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="employee_id"/>
                                <field name="shift_date"/>
                            </group>
                            <group>
                                <field name="shift_type"/>
                                <field name="workstation_id"/>
                                <field name="attendance_state"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="check_in"/>
                                <field name="check_out"/>
                            </group>
                            <group>
                                <field name="work_hours"/>
                                <field name="report_count"/>
                                <field name="output_weight_g"/>
                            </group>
                        </group>
                        <field name="note" placeholder="备注"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_gold_work_attendance" model="ir.actions.act_window">
            <field name="name">考勤 / 工时</field>
            <field name="res_model">gold.work.attendance</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
