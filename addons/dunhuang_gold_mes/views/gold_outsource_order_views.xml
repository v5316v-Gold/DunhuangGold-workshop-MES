<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_gold_outsource_order_tree" model="ir.ui.view">
            <field name="name">gold.outsource.order.tree</field>
            <field name="model">gold.outsource.order</field>
            <field name="arch" type="xml">
                <tree string="委外加工" decoration-danger="loss_rate &gt; 5" decoration-muted="state == 'cancelled'">
                    <field name="name"/>
                    <field name="issue_date"/>
                    <field name="partner_id"/>
                    <field name="process_type"/>
                    <field name="outsource_type"/>
                    <field name="outgoing_batch_id"/>
                    <field name="outgoing_weight_g" digits="[18,6]"/>
                    <field name="incoming_weight_g" digits="[18,6]"/>
                    <field name="incoming_piece_count"/>
                    <field name="loss_g" digits="[18,6]"/>
                    <field name="loss_rate" digits="[6,4]" widget="percentage"/>
                    <field name="processing_fee" digits="[16,2]"/>
                    <field name="total_amount" digits="[16,2]"/>
                    <field name="loss_charge_party"/>
                    <field name="state" widget="badge"
                        decoration-info="state in ['draft', 'issued']"
                        decoration-warning="state == 'processing'"
                        decoration-success="state in ['received', 'invoiced', 'closed']"
                        decoration-danger="state == 'cancelled'"/>
                </tree>
            </field>
        </record>

        <record id="view_gold_outsource_order_form" model="ir.ui.view">
            <field name="name">gold.outsource.order.form</field>
            <field name="model">gold.outsource.order</field>
            <field name="arch" type="xml">
                <form string="委外加工">
                    <header>
                        <button name="action_issue" string="发料" type="object"
                            class="btn-primary" states="draft"
                            groups="group_dunhuang_gold_mes_warehouse"/>
                        <button name="action_processing" string="加工中" type="object"
                            class="btn-primary" states="issued"
                            groups="group_dunhuang_gold_mes_leader"/>
                        <button name="action_receive" string="收回" type="object"
                            class="btn-primary" states="issued,processing"
                            context="{'default_incoming_weight_g': 0, 'default_incoming_piece_count': 0}"
                            groups="group_dunhuang_gold_mes_warehouse"/>
                        <button name="action_invoice" string="结算" type="object"
                            class="btn-primary" states="received"
                            groups="group_dunhuang_gold_mes_director"/>
                        <button name="action_close" string="关闭" type="object"
                            class="btn-primary" states="received,invoiced"
                            groups="group_dunhuang_gold_mes_director"/>
                        <button name="action_cancel" string="取消" type="object"
                            states="draft,issued,processing" groups="group_dunhuang_gold_mes_director"/>
                        <field name="state" widget="statusbar"
                            statusbar_visible="draft,issued,processing,received,closed"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name" placeholder="委外单号"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="partner_id"/>
                                <field name="outsource_type"/>
                                <field name="process_type"/>
                                <field name="production_id"/>
                                <field name="operation_id"/>
                            </group>
                            <group>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="issue_date"/>
                                <field name="expected_return_date"/>
                                <field name="actual_return_date"/>
                                <field name="loss_charge_party"/>
                            </group>
                        </group>
                        <group string="发料">
                            <group>
                                <field name="outgoing_batch_id"/>
                                <field name="outgoing_weight_g" digits="[18,6]"/>
                            </group>
                            <group>
                                <field name="incoming_weight_g" digits="[18,6]"/>
                                <field name="incoming_piece_count"/>
                                <field name="incoming_batch_id" readonly="True"/>
                            </group>
                        </group>
                        <group string="损耗">
                            <group>
                                <field name="loss_g" digits="[18,6]"/>
                                <field name="loss_rate" digits="[6,4]" widget="percentage"/>
                            </group>
                            <group/>
                        </group>
                        <group string="结算">
                            <group>
                                <field name="processing_fee" digits="[16,2]"/>
                                <field name="gold_loss_charge" digits="[16,2]"/>
                            </group>
                            <group>
                                <field name="total_amount" digits="[16,2]"
                                    class="oe_subtotal_footer_separator"/>
                                <field name="invoice_id"/>
                            </group>
                        </group>
                        <group string="检验">
                            <field name="cert_no"/>
                            <field name="cert_image" widget="image"/>
                        </group>
                        <field name="note" placeholder="备注"/>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="action_gold_outsource_order" model="ir.actions.act_window">
            <field name="name">委外加工</field>
            <field name="res_model">gold.outsource.order</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
