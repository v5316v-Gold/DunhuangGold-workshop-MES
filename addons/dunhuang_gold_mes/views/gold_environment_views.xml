<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ======================= 环境传感器 ======================= -->
        <record id="view_gold_environment_sensor_tree" model="ir.ui.view">
            <field name="name">gold.environment.sensor.tree</field>
            <field name="model">gold.environment.sensor</field>
            <field name="arch" type="xml">
                <tree string="环境传感器">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="sensor_type"/>
                    <field name="unit"/>
                    <field name="location_desc"/>
                    <field name="alarm_min"/>
                    <field name="alarm_max"/>
                    <field name="protocol"/>
                    <field name="active" widget="boolean_toggle"/>
                </tree>
            </field>
        </record>

        <record id="view_gold_environment_sensor_form" model="ir.ui.view">
            <field name="name">gold.environment.sensor.form</field>
            <field name="model">gold.environment.sensor</field>
            <field name="arch" type="xml">
                <form string="环境传感器">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name" placeholder="传感器名称"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="sensor_type"/>
                                <field name="unit"/>
                            </group>
                            <group>
                                <field name="location_desc"/>
                                <field name="workstation_id"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <group string="报警阈值">
                            <group>
                                <field name="alarm_min"/>
                                <field name="alarm_max"/>
                            </group>
                        </group>
                        <group string="通讯">
                            <group>
                                <field name="protocol"/>
                                <field name="device_node_id"/>
                                <field name="poll_interval_seconds"/>
                            </group>
                        </group>
                        <field name="note" placeholder="备注"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_gold_environment_sensor" model="ir.actions.act_window">
            <field name="name">环境传感器</field>
            <field name="res_model">gold.environment.sensor</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- ======================= 环境读数 ======================= -->
        <record id="view_gold_environment_reading_tree" model="ir.ui.view">
            <field name="name">gold.environment.reading.tree</field>
            <field name="model">gold.environment.reading</field>
            <field name="arch" type="xml">
                <tree string="环境读数" decoration-danger="state == 'alarm'">
                    <field name="reading_time"/>
                    <field name="sensor_id"/>
                    <field name="sensor_type"/>
                    <field name="value"/>
                    <field name="unit"/>
                    <field name="state" widget="badge"
                        decoration-success="state == 'normal'"
                        decoration-danger="state == 'alarm'"/>
                    <field name="alarm_desc"/>
                    <field name="source"/>
                </tree>
            </field>
        </record>

        <record id="view_gold_environment_reading_form" model="ir.ui.view">
            <field name="name">gold.environment.reading.form</field>
            <field name="model">gold.environment.reading</field>
            <field name="arch" type="xml">
                <form string="环境读数">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="sensor_id"/>
                                <field name="reading_time"/>
                            </group>
                            <group>
                                <field name="value"/>
                                <field name="unit"/>
                                <field name="state" widget="badge"/>
                                <field name="alarm_desc"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="source"/>
                            </group>
                        </group>
                        <field name="note" placeholder="备注"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_gold_environment_reading" model="ir.actions.act_window">
            <field name="name">环境读数</field>
            <field name="res_model">gold.environment.reading</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
