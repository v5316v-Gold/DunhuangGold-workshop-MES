<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_mrp_bom_form_inherit_gold" model="ir.ui.view">
            <field name="name">mrp.bom.form.inherit.gold</field>
            <field name="model">mrp.bom</field>
            <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
            <field name="arch" type="xml">
                <field name="code" position="before">
                    <field name="gold_standard_weight_g" digits="[18,6]"
                        string="标准单件克重 (g)"/>
                </field>
                <field name="code" position="after">
                    <field name="gold_process_type"/>
                    <field name="gold_route_id" string="工艺路线"/>
                    <field name="gold_bom_type"/>
                </field>
            </field>
        </record>

        <record id="view_mrp_bom_tree_inherit_gold" model="ir.ui.view">
            <field name="name">mrp.bom.tree.inherit.gold</field>
            <field name="model">mrp.bom</field>
            <field name="inherit_id" ref="mrp.mrp_bom_tree_view"/>
            <field name="arch" type="xml">
                <field name="code" position="after">
                    <field name="gold_process_type"/>
                    <field name="gold_standard_weight_g" digits="[18,6]"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
