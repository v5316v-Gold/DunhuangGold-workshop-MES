<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_gold_workorder_report_tree" model="ir.ui.view">
            <field name="name">gold.workorder.report.tree</field>
            <field name="model">gold.workorder.report</field>
            <field name="arch" type="xml">
                <tree string="工序报工" decoration-danger="is_over_loss" decoration-warning="quality_state != 'passed'">
                    <field name="name"/>
                    <field name="report_time"/>
                    <field name="production_id"/>
                    <field name="operation_id"/>
                    <field name="workstation_id"/>
                    <field name="operator_id"/>
                    <field name="input_batch_id"/>
                    <field name="input_weight_g" digits="[18,6]"/>
                    <field name="output_weight_g" digits="[18,6]"/>
                    <field name="loss_g" digits="[18,6]"/>
                    <field name="loss_rate" digits="[6,4]" widget="percentage"/>
                    <field name="standard_loss_rate" digits="[6,4]" widget="percentage"/>
                    <field name="loss_diff_pct" digits="[6,4]" widget="percentage"/>
                    <field name="is_over_loss" widget="boolean_toggle"/>
                    <field name="work_hours" digits="[10,4]"/>
                    <field name="quality_state" widget="badge"
                        decoration-success="quality_state == 'passed'"
                        decoration-danger="quality_state == 'failed'"
                        decoration-warning="quality_state in ['rework', 'scrap']"/>
                    <field name="source"/>
                </tree>
            </field>
        </record>

        <record id="view_gold_workorder_report_form" model="ir.ui.view">
            <field name="name">gold.workorder.report.form</field>
            <field name="model">gold.workorder.report</field>
            <field name="arch" type="xml">
                <form string="工序报工">
                    <header>
                        <field name="state" widget="statusbar"
                            statusbar_visible="draft,confirmed"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name" placeholder="报工单号"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="production_id"/>
                                <field name="workorder_id"/>
                                <field name="operation_id"/>
                                <field name="workstation_id"/>
                                <field name="equipment_id"/>
                                <field name="report_time"/>
                            </group>
                            <group>
                                <field name="operator_id"/>
                                <field name="inspector_id"/>
                                <field name="source"/>
                                <field name="balance_id"/>
                                <field name="start_time"/>
                                <field name="end_time"/>
                            </group>
                        </group>
                        <group string="重量 (电子天平直采)">
                            <group>
                                <field name="input_batch_id"/>
                                <field name="input_weight_g" digits="[18,6]"/>
                                <field name="output_batch_id"/>
                                <field name="output_weight_g" digits="[18,6]"/>
                                <field name="output_piece_count"/>
                            </group>
                            <group>
                                <field name="loss_g" digits="[18,6]"/>
                                <field name="loss_rate" digits="[6,4]" widget="percentage"/>
                                <field name="standard_loss_rate" digits="[6,4]" widget="percentage"/>
                                <field name="loss_diff_pct" digits="[6,4]" widget="percentage"/>
                                <field name="is_over_loss" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <group string="工时">
                            <group>
                                <field name="work_hours" digits="[10,4]"/>
                                <field name="standard_work_hours" digits="[10,4]"/>
                                <field name="time_diff" digits="[10,4]"/>
                            </group>
                            <group>
                                <field name="recyclable_wax_g" digits="[18,6]"/>
                                <field name="recyclable_gold_g" digits="[18,6]"/>
                            </group>
                        </group>
                        <group string="质量">
                            <field name="quality_state" widget="radio"
                                options="{'horizontal': true}"/>
                            <field name="defect_description"
                                placeholder="缺陷描述"
                                invisible="quality_state == 'passed'"/>
                        </group>
                        <field name="note" placeholder="备注"/>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="action_gold_workorder_report" model="ir.actions.act_window">
            <field name="name">工序报工</field>
            <field name="res_model">gold.workorder.report</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
