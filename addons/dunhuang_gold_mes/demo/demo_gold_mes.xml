        <!-- 演示工位 -->
        <record id="ws_oil_press_demo" model="gold.workstation">
            <field name="code">WS-OWP</field>
            <field name="name">油压工位</field>
            <field name="workstation_type">oil_press</field>
            <field name="process_type">oil_press</field>
            <field name="location">A 区-1</field>
            <field name="operation_ids" eval="[(6, 0, [ref('op_owp02'), ref('op_owp03'), ref('op_owp04'), ref('op_owp05'), ref('op_owp06')])]"/>
        </record>

